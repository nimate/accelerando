#!/usr/bin/env bash

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'verify-go: not inside a Git repository\n' >&2
  exit 1
}

cd "$repo_root" || exit 1

go_files=()

while IFS= read -r -d '' file; do
  if [[ -f "$file" ]]; then
    go_files+=("$file")
  fi
done < <(
  if git rev-parse --verify HEAD >/dev/null 2>&1; then
    git diff --name-only --diff-filter=ACMR -z HEAD -- '*.go'
  else
    git diff --cached --name-only --diff-filter=ACMR -z -- '*.go'
  fi

  git ls-files --others --exclude-standard -z -- '*.go'
)

if (( ${#go_files[@]} == 0 )); then
  printf 'verify-go: no changed Go files; nothing to verify\n'
  exit 0
fi

printf 'verify-go: formatting %d changed Go file(s)\n' "${#go_files[@]}"
if ! gofmt -w "${go_files[@]}"; then
  printf 'verify-go: gofmt failed\n' >&2
  exit 1
fi

run_check() {
  local label="$1"
  shift

  printf 'verify-go: running %s\n' "$label"
  if ! "$@"; then
    printf 'verify-go: %s failed\n' "$label" >&2
    return 1
  fi
}

run_check 'go vet ./...' go vet ./... || exit 1
run_check 'go test ./...' go test ./... || exit 1
run_check 'go test -race ./...' go test -race ./... || exit 1

printf 'verify-go: all checks passed\n'
