{
  "description": "Repository verification hooks",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/verify_go_stop.py\"",
            "timeout": 900,
            "statusMessage": "Running Go verification"
          }
        ]
      }
    ]
  }
}
