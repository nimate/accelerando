{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(mkdir *)",
      "Bash(make *)",
      "Bash(go test *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(pytest *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git clean *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)"
    ]
  }
}
